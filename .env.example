# Optional: create a free OpenSky API client for a larger daily request allowance.
# The app works without these credentials, but anonymous global refreshes are cached for 15 minutes.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Set this to the public deployment URL so social-preview links are absolute.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: switch the globe to another satellite XYZ tile provider.
# Keep {z}, {x}, and {y} in the URL and follow that provider's attribution terms.
NEXT_PUBLIC_SATELLITE_TILE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
